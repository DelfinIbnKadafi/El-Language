{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "El Language",
  "scopeName": "source.ellang",
  "fileTypes": ["ell"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#function-definition" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#function-call" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ellang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ellang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "comment": "function name(...) = -- the name gets its own distinctive scope",
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.function.ellang" },
            "2": { "name": "entity.name.function.ellang" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": "a bare identifier immediately followed by ( is a call, not a variable",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.ellang"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.ellang",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.control.loop.ellang",
          "match": "\\b(for|while)\\b"
        },
        {
          "name": "keyword.control.flow.ellang",
          "match": "\\b(return|exit)\\b"
        },
        {
          "name": "keyword.control.function.ellang",
          "match": "\\b(function)\\b"
        },
        {
          "name": "keyword.other.print.ellang",
          "match": "\\b(print)\\b"
        },
        {
          "name": "keyword.other.input.ellang",
          "match": "\\b(input)\\b"
        },
        {
          "name": "storage.type.var.ellang",
          "match": "\\b(var)\\b"
        },
        {
          "name": "keyword.operator.logical.ellang",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.ellang",
          "match": "\\b(int|float|str|bool)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ellang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.ellang",
          "match": "\\bNONE\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ellang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ellang",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ellang",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ellang",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.compound-assignment.ellang",
          "match": "(\\+=|-=)"
        },
        {
          "name": "keyword.operator.increment-decrement.ellang",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.comparison.ellang",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.ellang",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ellang",
          "match": "(\\+|-|\\*|/)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.ellang",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.ellang",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.ellang",
          "match": "(\\[|\\])"
        },
        {
          "name": "punctuation.section.parens.ellang",
          "match": "(\\(|\\))"
        },
        {
          "name": "punctuation.section.braces.ellang",
          "match": "(\\{|\\})"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.ellang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
