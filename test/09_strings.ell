// plain string, default max length
var str greeting = "Hi there";
print greeting;

// sized string, size comes right after "str"
var str[16] shortText = "fits fine";
print shortText;

// text longer than the declared size just gets cut off, shouldn't crash
var str[5] tiny = "this is way too long";
print tiny;

// array of sized strings, size is between str[] and the array size
var str[16] names[3];
names[0] = "Ana";
names[1] = "Budi";
print names[0];
print names[1];

// unset string elements should also be NONE
print names[2];
