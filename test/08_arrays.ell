// arrays are zero-indexed, size has no real upper limit
var int numbers[5];
numbers[0] = 10;
numbers[1] = 20;
print numbers[0];
print numbers[1];

// unset elements should be NONE, not 0
print numbers[2];

// broadcast initializer, fills every element with the same value
var int filled[5] = 0;
print filled[3];

// list initializer, should match each position in order
var int listed[4] = {1, 2, 3, 4};
print listed[2]; // should be 3

// a list shorter than the array size leaves the rest as NONE
var int partial[5] = {7, 8};
print partial[0];
print partial[4];

// copying one element into another, works as long as the types match
var int copyTarget[2];
copyTarget[0] = listed[3];
print copyTarget[0];

// arrays must always be indexed, using them bare is not allowed --
// this line is commented out on purpose since it should fail to compile
// print numbers;
