// function with array params

function createArray() =
  var int result[3] = {10, 20, 30};
  return result;

var int x[3] = createArray();  // x = {10, 20, 30}
print x[0];                    // 10
print createArray()[1];        // 20

var int myArr[3] = {5, 10, 15};

function sum(var int arr[3]) =
  return arr[0] + arr[1] + arr[2];

var int a = sum([1, 2, 3]);    // a = 6
var int b = sum(10);           // b = 30
var int c = sum(myArr);        // c = 30

print a;
print b;
print c;
