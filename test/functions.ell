function say_hello() =
  print "Hello!"; // no params, no return, should just print

say_hello(); // should print "Hello!"

function greet(var str[16] name) =
  print name; // should print whatever name is passed in

greet("Delfin"); // should print "Delfin"

function add(var int a, var int b) =
  return a + b; // should return the sum of both params

print add(3, 4); // should print 7, function call used directly inside print

function is_adult(var int age) =
  return age >= 18; // returns a bool

if(is_adult(20)) =
  print "Allowed"; // should print, since 20 >= 18

function check(var int n) =
  if(n < 0) =
    return; // early return with no value, should just stop the function here
  print n; // should only run if n is not negative

check(5); // should print 5
check(-1); // should print nothing, returns early

function factorial(var int n) =
  if(n <= 1) =
    return 1; // base case, stops the recursion here
  return n * factorial(n - 1); // should keep calling itself with a smaller n

print factorial(5); // should print 120

// fibonacci, just another common recursion example
function fib(var int n) =
  if(n <= 1) =
    return n;
  return fib(n - 1) + fib(n - 2);

print fib(6); // should print 8