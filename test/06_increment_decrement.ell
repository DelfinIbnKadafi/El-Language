// ++ and -- only work on int variables
var int counter = 0;
counter++;
counter++;
counter--;
print counter; // should be 1

// += and -= work on both int and float
var int total = 10;
total += 5;
total -= 2;
print total; // should be 13

var float balance = 100.0;
balance += 25.5;
print balance; // should be 125.5
