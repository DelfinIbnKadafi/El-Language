// NONE can apply to any data type: int, float, str, bool
var int a;
var str b;
var bool c;

// unset variables should already be NONE by default
if(a == NONE) =
  print "a is NONE";
if(b == NONE) =
  print "b is NONE";

// you can also assign NONE directly to a variable later on
var int d = 5;
d = NONE;
if(d == NONE) =
  print "d is NONE now";

// NOTE: assigning NONE to a string variable after it already has a value
// doesn't seem to flip its NONE status back on -- looks like a bug, worth
// double checking with Claude/the compiler before relying on it

// != NONE should work the other way around
c = true;
if(c != NONE) =
  print "c is not NONE anymore";

// NONE doesn't carry through math, missing values just act like 0 there
var int x;
var int y = x + 1; // x is NONE, so this becomes 0 + 1
print y; // should be 1, not NONE
