// basic if/else if/else chain
var int score = 75;

if(score >= 90) =
  print "A";
else if(score >= 70) =
  print "B"; // this branch should run, score is 75
else =
  print "C";

// inline single-line block should also work, no indentation needed
if(true) = print "inline block works";

// empty body shouldn't error, just does nothing
if(false) =
  print "never happens";
